{
  "name": "solid-emoji-picker",
  "version": "0.3.0",
  "private": false,
  "description": "Unstyled emoji picker for SolidJS",
  "keywords": [
    "emoji",
    "emoji-picker",
    "solid",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-emoji-picker/tree/main/packages/solid-emoji-picker",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-emoji-picker/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-emoji-picker.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0",
    "@solidjs/web": "2.0.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "solid-js": "2.0.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
